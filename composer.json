{
    "name": "yiisoft/yii-auth-client",
    "description": "Yii Framework external authentication via OAuth",
    "keywords": [
        "yii",
        "OAuth",
        "auth",
        "api"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii-auth-client/issues?state=open",
        "source": "https://github.com/yiisoft/yii-auth-client",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "require": {
        "php": "8.2 - 8.5",
        "psr/container": "^2.0.2",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "1.0",
        "psr/http-message": "^2.0",
        "psr/http-message-implementation": "1.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/simple-cache": "^2.0 || ^3.0",
        "psr/simple-cache-implementation": "*",
        "web-token/jwt-library": ">=4.0.6",
        "yiisoft/aliases": "^3.1",
        "yiisoft/assets": "^5.1.1",
        "yiisoft/factory": "^1.3",
        "yiisoft/html": "^3.11 || ^4.0",
        "yiisoft/http": "^1.2",
        "yiisoft/json": "^1.0",
        "yiisoft/router": "^4.0",
        "yiisoft/security": "^1.2",
        "yiisoft/session": "^3.0",
        "yiisoft/view": "^12.2.1",
        "yiisoft/widget": "^2.2"
    },
    "require-dev": {
        "ext-curl": "*",
        "friendsofphp/php-cs-fixer": "^3.68",
        "kriswallsmith/buzz": "^1.3",
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^11.5.9",
        "rector/rector": "^2.1.6",
        "roave/infection-static-analysis-plugin": "^1.39",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "vimeo/psalm": "^6.13.1",
        "yiisoft/cache": "^3.1",
        "yiisoft/code-style": "^1.1",
        "yiisoft/di": "^1.4",
        "yiisoft/psr-dummy-provider": "^1.0.2",
        "yiisoft/router-fastroute": "^4.0.1"
    },
    "suggest": {
        "ext-openssl": "Required to use the RsaSha OAuth1 signature method."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "Yiisoft\\Yii\\AuthClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Yii\\AuthClient\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "dependency-analyser": "composer-dependency-analyser",
        "rector": "rector",
        "test": "phpunit --stop-on-notice --display-phpunit-deprecations --testdox"
    }
}
